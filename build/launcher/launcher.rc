#include <winver.h>
1 ICON "../../assets/icon.ico"
1 24 "CapturePro.exe.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "Capture Pro"
      VALUE "FileDescription", "Capture Pro - capturador de imagens"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "CapturePro"
      VALUE "OriginalFilename", "CapturePro.exe"
      VALUE "ProductName", "Capture Pro"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
